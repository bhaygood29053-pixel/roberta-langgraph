# Copy values into your shell environment. Do not commit real API keys.
DEEPSEEK_API_KEY=your-key-here
ROBERTA_MODEL_PROVIDER=deepseek
ROBERTA_MODEL=deepseek-v4-flash

# Provider-backed CMIS gateway (Liquidity Scout service).
CMIS_BASE_URL=http://127.0.0.1:8765
CMIS_TIMEOUT_SECONDS=30
# CMIS_API_KEY=only-needed-when-the-gateway-requires-bearer-auth

# Phase 10 chain-provider gate. Keep false until the configured CMIS deployment
# has a live-verified Solana Provider. This flag does not contain provider keys.
ROBERTA_SOLANA_PROVIDER_ENABLED=false


# Roberta local HTTP bridge for local integrations such as MoltGrid/Signal.
# Keep the bridge loopback-bound unless a separately reviewed deployment needs otherwise.
ROBERTA_HOST=127.0.0.1
ROBERTA_PORT=8766
# ROBERTA_API_KEY=optional-local-bridge-bearer-token
