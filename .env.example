# Copy values into your shell environment. Do not commit real API keys.
DEEPSEEK_API_KEY=your-key-here
ROBERTA_MODEL_PROVIDER=deepseek
ROBERTA_MODEL=deepseek-v4-flash

# Provider-backed CMIS gateway (Liquidity Scout service).
CMIS_BASE_URL=http://127.0.0.1:8765
CMIS_TIMEOUT_SECONDS=30
# CMIS_API_KEY=only-needed-when-the-gateway-requires-bearer-auth

# Phase 10 chain-provider gate. Keep false until the configured CMIS deployment
# has a live-verified Solana Provider. This flag does not contain provider keys.
ROBERTA_SOLANA_PROVIDER_ENABLED=false


# Roberta HTTP gateway. Keep the bridge loopback-bound and expose it only
# through a separate HTTPS reverse proxy / secure tunnel when needed.
ROBERTA_HOST=127.0.0.1
ROBERTA_PORT=8766
# ROBERTA_API_KEY=generate-a-long-random-secret-and-store-it-outside-git


# Gateway Phase 2: local MCP edge for Secure MCP Tunnel / reviewed HTTPS edge.
# Keep this loopback-only. The same ROBERTA_API_KEY authenticates the MCP edge
# to the local Gateway v1 endpoint; never commit the real value.
ROBERTA_MCP_HOST=127.0.0.1
ROBERTA_MCP_PORT=8767
ROBERTA_MCP_UPSTREAM_URL=http://127.0.0.1:8766/v1/gateway/ask
ROBERTA_MCP_TIMEOUT_SECONDS=90
